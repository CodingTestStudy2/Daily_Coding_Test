'''
1. 아이디어 :
최대값과 최소값을 저장하고 해당 배열을 바탕으로 계산합니다

2. 시간복잡도 :
    O(n + n)

3. 자료구조/알고리즘 :
-

'''

class Solution:
    def firstStableIndex(self, nums: list[int], k: int) -> int:
        n = len(nums)
        alist = [[0,0] for _ in range(n)] # min, max
        alist[0][0] = nums[0]
        alist[-1][1] = nums[-1]

        for i in range(1, n):
            alist[i][0] = max(alist[i-1][0], nums[i])
            alist[n-i-1][1] = min(alist[n-i][1], nums[n-i-1])
        
        for i in range(n):
            cmax, cmin = alist[i]
            if cmax - cmin <= k:
                return i

        return -1
