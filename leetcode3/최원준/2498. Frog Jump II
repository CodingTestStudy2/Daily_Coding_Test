'''
1. 아이디어 :
다음돌을 건너뛰면서 그 다음돌만 밟으면서 뛰면 거리를 최소화 할 수 있습니다

2. 시간복잡도 :
    O(n)

3. 자료구조/알고리즘 :
그리디

'''
class Solution:
    def maxJump(self, stones: list[int]) -> int:
        n = len(stones)
        
        odd_max = 0
        even_max = 0
        ans = max(stones[1]-stones[0], stones[-1] - stones[-2])

        for i in range(0, n-2, 2):
            even_max = max(even_max, stones[i+2] - stones[i])
            # print(stones[i+2], stones[i])
        
        for i in range(1, n-2, 2):
            odd_max = max(odd_max, stones[i+2] - stones[i])
            # print(stones[i+2], stones[i])
        
        return max(ans, even_max, odd_max)
            
