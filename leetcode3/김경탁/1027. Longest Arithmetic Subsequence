class Solution:
    def longestArithSeqLength(self, nums: List[int]) -> int:
        n=len(nums)
        dp = [{} for _ in range(n)]
        num=2
        for i in range(n):
            for j in range(i):
                dif=nums[i]-nums[j]
                dp[i][dif]=dp[j].get(dif,1)+1
                num=max(num,dp[i][dif])
        return num
        
