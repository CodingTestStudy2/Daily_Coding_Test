class Solution {
    public int getLastMoment(int n, int[] left, int[] right) {
        // 문제내용 : 개미가 갈 수 있는 거리에 대한 최대 시간 구하기 (겹침 상관없이)
        int maxTime = 0;

        // 개미가 좌측으로 이동하는 데 걸리는 최대 시간
        for (int pos : left) {
            maxTime = Math.max(maxTime, pos);
        }

        // 개미가 우측으로 이동하는 데 걸리는 최대 시간 
        for (int pos : right) {
            maxTime = Math.max(maxTime, n-pos);
        }

        return maxTime;
    }
}

// 시간복잡도 : O(L + R) => 각 배열을 좌측, 우측 한 번씩 순회함
