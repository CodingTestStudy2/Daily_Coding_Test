class Solution {
    public int maxValue(int n, int index, int maxSum) {
        int left = 1; 
        int right = maxSum; 
        int answer = 1; 

        // 비교하려는 대상 값보다 작을 때 
        while (left <= right) {
            // 좌측과 우측값의 간격을 이용하여 중간값 구하기 
            int mid = left + (right - left) / 2; 

            // index 위치의 값이 mid일 때 가능한 배열의 최소 합 계산 (양 옆의 숫자를 1칸씩 줄이기)
            long leftSum = getSideSum(mid - 1, index);
            long rightSum = getSideSum(mid - 1, n - 1 - index);     
            long totalSum = leftSum + mid + rightSum; 

            // 총 합이 최대값보다 작을 때
            if (totalSum <= maxSum) {
                answer = mid;
                left = mid + 1;         // 좌측 점을 우측으로 한 칸 땡기기 
            } else {
                right = mid - 1;        // 우측 점을 좌측으로 한 칸 땡기기 
            }
        }

        return answer; 
    }

    // peak에서 시작해 1씩 감소하며 count개의 원소를 채울 때의 최소 합 
    private long getSideSum(long peak, int count) {
        if (peak >= count) {
            // 1에 도달하기 전에 칸이 모두 채워지는 경우 (등차수열의 합)
            long first = peak - count + 1; 
            long last = peak; 
            return (first + last) * count / 2; 
        } else {
            // 1까지 감소한 뒤 남은 칸을 모두 1로 채우는 경우 
            long sumToOne = (1 + peak) * peak / 2; 
            long remainingOnes = count - peak; 
            return sumToOne + remainingOnes;
        }
    }
}

// 시간복잡도 : 변수가 1씩 일정하게 증가하는 걸 봐서 O(1)로 추정 
