class Solution {
    public int[] countPoints(int[][] points, int[][] queries) {
        int[] answer = new int[queries.length];     // 정답 배열 생성 

        // queries 배열 = [x좌표, y좌표, 반지름]
        // queries 배열 만들기 
        for (int i = 0; i < queries.length; i++) {
            int cx = queries[i][0];         // x좌표 
            int cy = queries[i][1];         // y좌표
            int r = queries[i][2];          // 반지름 
            int rSquared = r * r;           // 원 만들기 

            int count = 0; 
            // 모든 점을 순회하기 
            for (int[] point : points) {
                // 원의 중심과 현재 점의 좌표 차이 
                int dx = point[0] - cx; 
                int dy = point[1] - cy; 
                
                // 두 점 사이의 거리가 반지름 이하여야 함
                if (dx * dx + dy * dy <= rSquared) {
                    count++;
                }
            }
            answer[i] = count;
        }
        return answer; 
    }
}

// 시간복잡도 : x축과 y축 값을 곱하는걸 봐서 O(QxP)로 추정
