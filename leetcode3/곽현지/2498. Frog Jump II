
class Solution {
    public int maxJump(int[] stones) {
        // 1. 첫 번째와 두 번째 돌 사이의 거리
        int answer = stones[1] - stones[0];

        // 2. 한 칸씩 건너뛴 돌 사이의 거리 계산
        for (int i = 2; i < stones.length; i++) {
            int distance = stones[i] - stones[i - 1];

            // 3. 가장 긴 점프 거리 저장
            answer = Math.max(answer, distance);
        }

        // 4. 최소화할 수 있는 최대 점프 거리 반환
        return answer;
    }
}
