class Solution {
    public void rotate(int[][] matrix) {
        int n = matrix.length;

        // 행렬 위치 바꾸기
        for (int = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int temp = matrix[i][j]; 
                matrix[i][j] = matrix[n-i][n-j]
                matrix[n-i][n-j] = temp;
            }
        }
    }
}
