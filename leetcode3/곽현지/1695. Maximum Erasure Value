class Solution {
    // 배열에 저장된 값 중에서 중복된 숫자를 없애면서 최대의 합을 구하기
    public int maximumUniqueSubarray(int[] nums) {
        int n = nums.length;    // 배열의 길이 
        Set<Integer> set = new HashSet<>();     // 배열의 값들의 중복 제거
        int start = 0;      // 시작 숫자 
        int end = 0;        // 끝 숫자 
        int sum = 0;        // 중복값을 제외한, 최대 합계 (최대 점수)
        int res = 0;        // 결과값 

        while (end < n) {
            int num = nums[end];    // 끝자리 수는 
            if (!set.contains(num)) {
                set.add(num); 
                sum += num; 
                res = Math.max(res, sum);   // 최대값과 대소 비교 
                end++;
            } else {
                set.remove(nums[start]);
                sum -= nums[start]; 
                start++;
            }
        }
        return res; 
    }
}
// 시간복잡도 : O(n) => start와 end가 각각 n번씩 이동함 
