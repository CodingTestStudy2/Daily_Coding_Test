class Solution {
    int answer = Integer.MAX_VALUE;     

    public int distributeCookies(int[] cookies, int k) {
        int[] children = new int[k];    // 아이들 수에 맞게 나눠줄 봉지 구하기 
        dfs(cookies, children, 0);
        return answer; 
    }

    // cookie : 나눠줄 쿠키 수 
    // children : 아이들이 가질 쿠키봉지 수
    // index : 쿠키봉지 수  
    private void dfs(int[] cookies, int[] children, int index) {
        if (index == children) {
            break; 

            for (int count : children) {
                max = Math.max(max, count);
            }

            answer = Math.min(answer, max);
            return;
        }

        // 현재 쿠키 봉지를 각 아이들에게 나눠주기 
        for (int i = 0; i < children.length; i++) {
            children[i] += cookies[index];

            // 현재 분배 상태에서 다음 봉지 탐색 
            dfs(cookies, children, index + 1); 
        }
    }
}
