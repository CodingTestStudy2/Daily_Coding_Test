import java.util.Set;
import java.util.HashSet;

class Solution {
    public boolean isValidSudoku(char[][] board) {
        Set<String> trace = new HashSet<>();        // 중복된 값 입력을 방지하기 위함 

        // 행렬 수 만들기 
        for (int i = 0; i < 9; i++) {
            for (int j = 0; j < 9; j++) {
                // 행렬 만들기 
                char num = board[i][j]; 

                // 칸이 비워져 있을 경우, 숫자 채우기위해 계속 진행하기 
                if (num == '.') {
                    continue;
                }

                String row = "row" + i + num; 
                String col = "col" + j + num; 
                String box = "box" + (i / 3) + (j / 3) + num; 

                // 빈 칸에 trace에 저장된 숫자가 있을 경우, 숫자 입력 X
                if (trace.contains(row) ||
                    trace.contains(col) ||
                    trace.contains(box)) {
                    return false; 
                }
                trace.add(row);
                trace.add(col);
                trace.add(box);
            }
        }
        return true;
    }
}
