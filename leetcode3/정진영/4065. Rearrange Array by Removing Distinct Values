/**
 * @param {number[]} nums
 * @return {number[]}
 */
var rearrangeArray = function(nums) {
    let ans = [];

    nums.sort((a,b)=>a-b);

    while (nums.length > 0){
        let set = new Set();
        let after = [];

        for (let i = 0; i<nums.length; i++){
            if (!set.has(nums[i])){
                set.add(nums[i]);
                ans.push(nums[i]);
            } else {
                after.push(nums[i]);
            }
        }

        nums = after;
    }

    return ans;
};
