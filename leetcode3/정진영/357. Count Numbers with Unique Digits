/**
 * @param {number} n
 * @return {number}
 */
var countNumbersWithUniqueDigits = function(n) {
    let ans = 10;
    let count = 9;
    if (n == 0){
        return 1;
    } else if (n==1) {
        return ans;
    } else {
        // 한자리수 0~9 -> 10개
        // 2자리수 1~9 -> 9개 * 9개(0~9 중 첫째자리 제외)
        // 3자리수 9 * 9 * 8
        // 9*9*8*7
        let next = 9;
        for (let i = 2; i <= n; i++){ // n==3 
           count = count * next; // count = 9*9 count = 9*9*8
           ans = ans + count;   // 81+10
           next--;  // 8
        }
    }
    return ans;
};
