/**
 * @param {number[]} nums
 * @param {number} k
 * @return {number}
 */
var absDifference = function(nums, k) {
    const arr = nums.sort((a, b) => a-b);
    let sum1 = 0;
    let sum2 = 0;
    for(let i = 0; i<k; i++){
        sum1 += arr[i];
        sum2 += arr[arr.length-i-1];
    }
    let abs = sum2 - sum1;
    return abs;
};
