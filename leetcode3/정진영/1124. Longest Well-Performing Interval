/**
 * @param {number[]} hours
 * @return {number}
 */
var longestWPI = function(hours) {
    let ans = 0;

    for (let i = 0; i < hours.length; i++) {
        let sum = 0;

        for (let j = i; j < hours.length; j++) {
            if (hours[j] > 8) {
                sum += 1;
            } else {
                sum -= 1;
            }

            if (sum > 0) {
                ans = Math.max(ans, j - i + 1);
            }
        }
    }

    return ans;
};
