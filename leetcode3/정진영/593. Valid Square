/**
 * @param {number[]} p1
 * @param {number[]} p2
 * @param {number[]} p3
 * @param {number[]} p4
 * @return {boolean}
 */
var validSquare = function(p1, p2, p3, p4) {
    function distance(a,b){
        let dx = a[0] - b[0];
        let dy = a[1] - b[1];

        return dx * dx + dy * dy;
    }

     let arr = [
        distance(p1, p2),
        distance(p1, p3),
        distance(p1, p4),
        distance(p2, p3),
        distance(p2, p4),
        distance(p3, p4)
    ];

    arr.sort((a, b) => a - b);

    return (
        arr[0] > 0 &&
        arr[0] === arr[1] &&
        arr[1] === arr[2] &&
        arr[2] === arr[3] &&
        arr[4] === arr[5]
    );
};
