/**
 * @param {string} s
 * @return {boolean}
 */
var isValid = function(s) {
    const arr = [];

    for (let i = 0; i<s.length; i++){
        if(s[i] == '(' || s[i] == '{' || s[i] == '['){
            arr.push(s[i]);
        } else {
            if (s[i] == ')' && arr[arr.length-1] !== '('){
                return false;
            } else if (s[i] == '}' && arr[arr.length-1] !== '{'){
                return false;
            } else if (s[i] == ']' && arr[arr.length-1] !== '['){
                return false;
            }
            arr.pop();
        }
    }
    
    return arr.length == 0;
};

