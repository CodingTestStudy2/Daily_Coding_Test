/**
 * @param {string} s
 * @return {number}
 */
var minRotations = function(s) {
    let ans = 0;
    let curr = 0; 

    for (let i = 0; i < s.length; i++) {
        let next = Number(s[i]); 

        let diff = Math.abs(curr - next);

        if (diff <= 5) {
            ans += diff;
        } else {
            ans += 10 - diff;
        }

        curr = next;
    }

    return ans;
};
