class Solution:

    def is_poss(self,grid,y,need):
        for x in range(len(grid)-need,len(grid) ):
            if grid[y][x]==1:return False
        return True
    def swap(self,grid,a,b):
        temp=grid[a]
        grid[a]=grid[b]
        grid[b]=temp


    
    def minSwaps(self, grid: list[list[int]]) -> int:
        n=len(grid)
        ans=0
        for y in range(n):
            need=n-(y+1)
            target=-1
            for ny in range(y,n):
                if self.is_poss(grid,ny,need):
                    target=ny
                    break
            if target==-1:return -1
            while target>y:
                ans+=1
                self.swap(grid,target,target-1)
                target-=1
                
        return ans

        
