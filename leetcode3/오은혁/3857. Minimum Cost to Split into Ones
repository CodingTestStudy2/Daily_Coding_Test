class Solution:
        
    def minCost(self, n: int) -> int:
        if n==1:return 0
        if n==2:return 1
        dp=[0]*(n+1)
        dp[1]=0
        dp[2]=1
        dp[3]=3
        for i in range(4,n+1):
            m=float('inf')
            for j in range(1,i//2+1):
                m=min(m,dp[j]+dp[i-j]+(j*(i-j)))
            dp[i]=m
        return dp[n]
