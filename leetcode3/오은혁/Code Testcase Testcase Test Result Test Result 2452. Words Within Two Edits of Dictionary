class Solution:
    def is_same(self,a,b):
        cnt=0
        for i in range(len(a)):
            if a[i]!=b[i]:cnt+=1
        if cnt>2:return False
        return True
    def twoEditWords(self, queries: list[str], dictionary: list[str]) -> list[str]:
        ans=[]
        for a in queries:
            for b in dictionary:
                if self.is_same(a,b):
                    ans.append(a)
                    break
        return ans
                

        
