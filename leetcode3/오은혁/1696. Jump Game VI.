import heapq
class Solution:
    def maxResult(self, nums: list[int], k: int) -> int:
        hq=[]
        dp=[0]*len(nums)
        dp[0]=nums[0]
        heapq.heappush(hq,(-dp[0],0))
        for i in range(1,len(nums)):
            while hq and hq[0][1]<i-k:

                heapq.heappop(hq)


            
            dp[i]=-hq[0][0]+nums[i]
            heapq.heappush(hq,(-dp[i],i))
        return dp[-1]
        
