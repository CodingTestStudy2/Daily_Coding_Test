class Solution:
    def minimumTeachings(self, n: int, languages: list[list[int]], friendships: list[list[int]]) -> int:
        impossible=[]
        ans=float('inf')
        for u,v in friendships:
            if len(set(languages[u-1])&set(languages[v-1]))==0:
                impossible.append([u,v]) 


        for l in range(1,n+1):
            cnt=0
            temp_lang=[set(y) for y in languages]

            for u,v in impossible:
                if l not in temp_lang[u-1]:
                    temp_lang[u-1].add(l)
                    cnt+=1
                if l not in temp_lang[v-1]:
                    temp_lang[v-1].add(l)
                    cnt+=1
            ans=min(ans,cnt)
        return ans
                

