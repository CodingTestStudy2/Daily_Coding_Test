class Solution:
    def fall(self,grid,y,x):
        
        if grid[y][x]==1:
            if x==len(grid[0])-1:return -1
            if grid[y][x+1]==-1:return -1
            if y+1==len(grid):
                return x+1
            return self.fall(grid,y+1,x+1)

        else:
            if x==0:return -1
            if grid[y][x-1]==1:return -1
            if y+1==len(grid):
                return x-1
            return self.fall(grid,y+1,x-1)

    def findBall(self, grid: list[list[int]]) -> list[int]:
        ans=[]
        for x in range(len(grid[0])):
            ans.append(self.fall(grid,0,x))
                
        return ans
        
