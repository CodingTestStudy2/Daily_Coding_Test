class Solution:
    def reinitializePermutation(self, n: int) -> int:
        lst = list(range(n))
        target = lst
        cnt = 0
        while True:
            arr = [0] * n
            for i in range(n):
                if i % 2 == 0:
                    arr[i] = lst[i // 2]
                else:
                    arr[i] = lst[n // 2 + (i - 1) // 2]
            lst = arr
            cnt += 1
            if lst == target:
                return cnt
