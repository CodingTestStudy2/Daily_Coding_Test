class Solution:
    def maximumUniqueSubarray(self, nums: list[int]) -> int:
        numbers = set()
        total = 0
        answer = 0
        rm = 0
        
        for i in range(len(nums)):

            while nums[i] in numbers:
                numbers.remove(nums[rm])
                total -= nums[rm]
                rm += 1

            # numbers에 없으면 추가
            numbers.add(nums[i])
            total += nums[i]
            answer = max(answer, total)

        return answer
