class Solution:
    def subArrayRanges(self, nums: list[int]) -> int:
        result = 0
        n = len(nums)

        for i in range(n):
            
            # 각각의 최댓값 부분배열 개수
            l = i
            while l > 0 and nums[l - 1] < nums[i]:
                l -= 1
            
            r = i
            while r < n-1 and nums[r+1] <= nums[i]:
                r +=1

            result += nums[i] * (i-l+1)*(r-i+1)

            # 각각의 최솟값 부분배열 개수
            l = i
            while l > 0 and nums[l - 1] > nums[i]:
                l -= 1
            
            r = i
            while r < n-1 and nums[r+1] >= nums[i]:
                r +=1

            result -= nums[i] * (i-l+1)*(r-i+1)

        return result
