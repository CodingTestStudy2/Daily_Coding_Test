from collections import deque

class Solution:
    def maxResult(self, nums: list[int], k: int) -> int:
        q = deque()
        q.append(0)


        for i in range(1, len(nums)):
            nums[i] += nums[q[0]]

            while q and nums[q[-1]] <= nums[i]:
                q.pop()

            q.append(i)

            if q[0] <= i-k:
                q.popleft()

        return nums[-1]
