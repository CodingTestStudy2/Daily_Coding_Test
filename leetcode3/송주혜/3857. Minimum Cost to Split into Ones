class Solution:
    def minCost(self, n: int) -> int:
        dp = [0] * (n+1)

        for i in range(2, n+1):
            max_v = 1e9

            for j in range(1, i):
                cost = j*(i-j) + dp[j] + dp[i-j]

                if cost < max_v:
                    max_v = cost

            dp[i] = max_v
        return dp[n]
