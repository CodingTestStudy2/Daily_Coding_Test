class Solution:
    def maxDistance(self, position: list[int], m: int) -> int:
        result = 0
        
        position.sort()

        left = 1
        right = position[-1] - position[0]

        while left <= right:
            mid = (left + right) // 2

            cnt = 1
            latest = position[0]

            for i in position[1:]:
                if mid <= i - latest:
                    cnt += 1
                    latest = i
            
            if cnt >= m:
                result = mid
                left = mid + 1
            else:
                right = mid -1

        return result
