'''
1. 아이디어 :
   - prefix_max[i] : nums[0..i]의 최댓값을 미리 계산
   - suffix_min[i] : nums[i..n-1]의 최솟값을 미리 계산
   - ins_score = prefix_max[i] - suffix_min[i] → O(1)로 계산
   - ins_score <= k 인 첫 번째 i 반환
   - 없으면 -1 반환

2. 시간복잡도 :
   O(n)  → prefix_max, suffix_min 각각 O(n) + 탐색 O(n)

3. 자료구조/알고리즘 :
   - Array (prefix_max, suffix_min 저장)
   - Prefix/Suffix Precomputation
'''

class Solution:
    def firstStableIndex(self, nums: list[int], k: int) -> int:
        n = len(nums)

        prefix_max = [0] * n
        prefix_max[0] = nums[0]
        for i in range(1, n):
            prefix_max[i] = max(prefix_max[i-1], nums[i])

        suffix_min = [0] * n
        suffix_min[n-1] = nums[n-1]
        for i in range(n-2, -1, -1):
            suffix_min[i] = min(suffix_min[i+1], nums[i])

        for i in range(n):
            if prefix_max[i] - suffix_min[i] <= k:
                return i

        return -1
